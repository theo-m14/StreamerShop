{% extends 'base.html.twig' %}

{% block title %}Mes produits{% endblock %}

{% block body %}
    <h1 class="has-text-centered is-size-3 mb-4">Mes produits</h1>
    <div class="buttons is-centered">
        <a href="{{ path('app_product_new') }}" class="button is-primary">Créer un nouveau produit</a>
    </div>
    <table class="table is-striped is-fullwidth has-text-centered">
        <thead>
            <tr>
                <th class="has-text-centered">Id</th>
                <th class="has-text-centered">Ref</th>
                <th class="has-text-centered">Title</th>
                <th class="has-text-centered">Image</th>
                <th class="has-text-centered">Price</th>
                <th class="has-text-centered">Stock</th>
                <th class="has-text-centered">actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.ref }}</td>
                <td>{{ product.title }}</td>
                <td><img src="{{ asset('images/products/' ~ product.imageName) }}" alt="{{ product.title }}" /></td>
                <td>{{ product.price }}</td>
                <td>{{ product.stock }}</td>
                <td>
                    <div class="buttons is-centered">
                        <a href="{{ path('app_product_show', {'id': product.id}) }}" class="button is-primary">Voir</a>
                        <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="button is-info">Modifier</a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" class="has-text-centered">Aucun produit trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    
{% endblock %}
