{% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
    

    <div class="container is-max-tablet">
        <div class="box">
            <h1 class="title is-4">Détails du produit</h1>
            <table class="table is-fullwidth has-text-centered">
                <tbody>
                    <tr>
                <th class="has-text-centered">Id</th>
                <td>{{ product.id }}</td>
            </tr>
            <tr>
                <th class="has-text-centered">Ref</th>
                <td>{{ product.ref }}</td>
            </tr>
            <tr>
                <th class="has-text-centered">Title</th>
                <td>{{ product.title }}</td>
            </tr>
            <tr>
                <th class="has-text-centered">Image</th>
                <td><img src="{{ asset('images/products/' ~ product.imageName) }}" alt="{{ product.title }}" /></td>
            </tr>
            <tr>
                <th class="has-text-centered">Price</th>
                <td>{{ product.price }}</td>
            </tr>
            <tr>
                <th class="has-text-centered">Stock</th>
                <td>{{ product.stock }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="buttons is-centered mt-5">
        <a class="button is-primary"  href="{{ path('app_product_index') }}">Retour à la liste</a>
        <a class="button is-primary"  href="{{ path('app_product_edit', {'id': product.id}) }}">Modifier</a>
        {{ include('product/_delete_form.html.twig') }}
    </div>


{% endblock %}
