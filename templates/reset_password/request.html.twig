{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    
    <div class="container is-max-tablet">
    {{ form_start(requestForm, {'attr': {'class': 'box content'}}) }}

            <h1 class="title">Réinitialiser votre mot de passe</h1>
            <div class="field">
                {{ form_label(requestForm.email, 'Adresse e-mail', {'class': 'label'}) }}
                <div class="control has-icons-left">
                    <span class="icon is-small is-left">
                        <i class="fas fa-envelope"></i>
                    </span>
                    {{ form_widget(requestForm.email, {'attr': {'class': 'input'}}) }}
                </div>
            </div>
            <div class="has-text-centered">
                <small class="is-size-7 italic mb-6">
                Entrez votre adresse e-mail, et nous vous enverrons un
                lien pour réinitialiser votre mot de passe.
            </small>
        </div>

        <div class="buttons is-centered mt-6">
            <button class="button is-primary">Envoyer l'e-mail</button>
        </div>
    {{ form_end(requestForm) }}
</div>
{% endblock %}
