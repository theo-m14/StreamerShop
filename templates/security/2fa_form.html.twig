{% extends 'base.html.twig' %}

{% block title %}Double Authentification
{% endblock %}
{% block body %}

	<div class="container is-max-tablet">
	<form action="{{ checkPathUrl ? checkPathUrl: path(checkPathRoute) }}" method="post" class="box">
		<h1 class="title is-4">Double Authentification</h1>
		<label class="label">
			Code de vérification
		</label>
		{% if authenticationError %}
			<p class="form-error">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</p>
		{% endif %}

		<p class="widget">
			<input id="_auth_code" class="input" type="text" name="{{ authCodeParameterName }}" autocomplete="one-time-code" autofocus inputmode="numeric" pattern="[0-9]*" {# https://www.twilio.com/blog/html-attributes-two-factor-authentication-autocomplete If your 2fa methods are using numeric codes only, add these attributes for better user experience: inputmode="numeric" pattern="[0-9]*" #}/>
		</p>
		{% if isCsrfProtectionEnabled %}
			<input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
		{% endif %}
		<div class="buttons is-centered">
			<input type="submit" value="{{ "login"|trans({}, 'SchebTwoFactorBundle') }}" class="button is-primary mt-4"/>
		</div>
		{# The logout link gives the user a way out if they can't complete two-factor authentication #}
		<p class="cancel mt-4 has-text-centered">
			<a href="{{ logoutPath }}">{{ "cancel"|trans({}, 'SchebTwoFactorBundle') }}</a>
		</p>
	</form>
	</div>


{% endblock %}
